{
  "name": "musicdeck",
  "version": "0.41.3",
  "description": "Turns the Soundtracks tab of the Quick Access Menu into a music player for local files, Steam soundtracks, media servers, streaming services, internet radio, podcasts and live concert recordings",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/ui/setup.mjs --test tests/ui/*.test.ts",
    "smoke": "node --import ./tests/ui/setup.mjs --test tests/smoke/*.test.mjs"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "music",
    "navidrome",
    "jellyfin",
    "radio",
    "soundtracks"
  ],
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-musl": "^4.53.3"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "hls.js": "1.6.13",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
